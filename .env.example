# GUI: http://127.0.0.1:8080 -> backend: http://127.0.0.1:8765
# M365 Copilot uses the connection dialog (tenant/client IDs), not LLM_API_KEY.
# See M365_SETUP.md. No client secret is required.
GUI_PORT=8080
API_PORT=8765
# Optional OpenAI-compatible Chat Completions endpoint. Never store keys in Git.
# No document is sent to AI unless the user presses the AI analysis button.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT=120
# External HTTPS endpoint is disabled by default. Enable only for approved data processing.
ALLOW_REMOTE_LLM=false
